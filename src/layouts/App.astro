---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import TabBar from "../components/TabBar.astro";
import SizeSheet from "../components/SizeSheet.astro";
import PlayBar from "../components/PlayBar.astro";
import WebNav from "../components/WebNav.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title?: string;
  active: "inicio" | "combos" | "catalogo" | "carrito";
}

const { title = "Montclair", active } = Astro.props;
const site = Astro.site?.href.replace(/\/$/, "") ?? Astro.url.origin;
const pageUrl = new URL(Astro.url.pathname, site).href;
const ogImage = new URL("/og.jpg", site).href;
const description =
  "Montclair. Decants originales en 3, 5 y 10 ml. El mismo jugo, sin comprar el frasco. Pedís por WhatsApp. Salimos de Estelí.";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#000000" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_NI" />
    <meta property="og:site_name" content="Montclair" />
    <meta property="og:title" content={`${title} · Montclair`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Montclair. Prueba el perfume antes del frasco. Estelí." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} · Montclair`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/jpeg" href="/brand/logo-source.jpg" />
    <link rel="apple-touch-icon" href="/brand/icon.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title} · Montclair</title>
    <ClientRouter />
  </head>
  <body>
    <div class="app-shell flex min-h-dvh flex-col">
      <WebNav active={active} />
      <main data-app-main class="flex-1">
        <slot />
      </main>
      <SiteFooter />
      <div class="fixed bottom-0 left-1/2 z-30 w-full max-w-[430px] -translate-x-1/2 md:hidden">
        <PlayBar />
        <TabBar active={active} />
      </div>
    </div>
    <SizeSheet />
    <script src="../scripts/app.ts"></script>
  </body>
</html>
