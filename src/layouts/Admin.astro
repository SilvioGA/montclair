---
import "../styles/global.css";

interface Props {
  title?: string;
}
const { title = "Panel" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600&family=Outfit:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title} · Montclair</title>
    <style>
      html, body { background: #000; }
      body.admin-lock { overflow: hidden; }
      [data-admin] button,
      [data-admin] a,
      [data-admin] label,
      [data-admin] select,
      [data-admin] summary {
        cursor: pointer;
      }
      [data-admin] input[type="checkbox"] { cursor: pointer; }
      [data-admin] button:disabled { cursor: default; }
      [data-form="store"] input:not([type="checkbox"]):not([type="radio"]),
      [data-form="store"] textarea,
      [data-form="store"] select {
        background-color: #111;
      }
      [data-modal-form] {
        min-height: 0;
      }
    </style>
  </head>
  <body class="bg-night text-cream">
    <slot />
    <script src="../scripts/admin.ts"></script>
  </body>
</html>
