<div
  data-added-bar
  class="invisible pointer-events-none fixed inset-x-0 bottom-[calc(3.75rem+env(safe-area-inset-bottom))] z-50 mx-auto w-full max-w-[430px] px-4 opacity-0 transition-all duration-200"
>
  <div class="rounded-2xl bg-cream px-4 py-3 text-night shadow-[0_12px_40px_#00000066]">
    <p data-added-text class="font-app text-sm font-semibold">Listo, ya está en el carrito.</p>
    <div class="mt-2.5 grid grid-cols-2 gap-2">
      <button type="button" data-added-stay class="h-10 rounded-lg bg-night/8 font-micro text-xs font-semibold">
        Seguir mirando
      </button>
      <a href="/carrito" class="flex h-10 items-center justify-center rounded-lg bg-night font-micro text-xs font-semibold text-cream">
        Ir a pagar
      </a>
    </div>
  </div>
</div>
