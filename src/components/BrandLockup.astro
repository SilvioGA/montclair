---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<a href="/" class="flex items-center gap-2.5 min-w-0">
  <img
    src="/brand/logo-source.jpg"
    alt="Montclair"
    class:list={["shrink-0 object-contain", compact ? "h-9 w-9" : "h-11 w-11"]}
  />
  <span class="min-w-0 leading-none">
    <span class="block font-brand text-[15px] tracking-[0.22em] text-cream">MONTCLAIR</span>
    <span class="mt-1 block font-micro text-[8px] font-semibold tracking-[0.28em] text-cream/70">DECANT / FRAGRANCE</span>
  </span>
</a>
