---
---

<div data-sheet-root class="invisible pointer-events-none fixed inset-0 z-50">
  <div data-sheet-dim data-sheet-close class="sheet-dim absolute inset-0" aria-hidden="true"></div>
  <div
    data-sheet-panel
    class="absolute inset-x-0 bottom-0 mx-auto w-full max-w-[430px] rounded-t-[20px] bg-lift px-5 pt-3 pb-7"
  >
    <div class="mb-3 flex justify-center">
      <span class="h-1 w-9 rounded-full bg-hair"></span>
    </div>
    <div class="mb-3.5 flex items-center gap-3">
      <img data-sheet-image alt="" class="h-[72px] w-14 rounded-md object-cover bg-night" />
      <div>
        <p data-sheet-house class="font-micro text-[10px] font-semibold tracking-[0.12em] text-amber"></p>
        <p data-sheet-name class="font-poster text-[26px] leading-none text-cream"></p>
        <p class="mt-1 font-app text-sm text-mist">¿De cuánto lo quieres?</p>
      </div>
    </div>
    <div data-sheet-sizes class="flex flex-col gap-2"></div>
    <button
      type="button"
      data-sheet-confirm
      class="mt-3.5 flex h-[52px] w-full items-center justify-center rounded-lg bg-amber font-micro text-[15px] font-semibold text-night"
    >
      Sumar
    </button>
    <button type="button" data-sheet-close class="mt-2.5 w-full text-center font-app text-[13px] text-mist">
      Seguir mirando
    </button>
  </div>
</div>
