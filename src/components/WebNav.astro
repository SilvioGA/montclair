---
import BrandLockup from "./BrandLockup.astro";

interface Props {
  active: "inicio" | "combos" | "catalogo" | "carrito";
}

const { active } = Astro.props;
const links = [
  { id: "inicio", href: "/", label: "Inicio" },
  { id: "catalogo", href: "/catalogo", label: "Catálogo" },
  { id: "combos", href: "/combos", label: "Combos" },
] as const;
---

<header class="hidden md:block sticky top-0 z-30 border-b border-hair/80 bg-night/80 backdrop-blur-xl">
  <div class="mx-auto flex h-20 max-w-[1280px] items-center justify-between gap-10 px-10">
    <BrandLockup />
    <nav class="flex items-center gap-9">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              "relative font-micro text-[13px] font-semibold tracking-[0.16em] uppercase",
              active === link.id ? "text-cream" : "text-mist hover:text-cream",
            ]}
          >
            {link.label}
            {active === link.id && <span class="absolute -bottom-1 left-0 h-px w-full bg-amber"></span>}
          </a>
        ))
      }
    </nav>
    <a
      href="/carrito"
      data-cart-target
      aria-label="Carrito"
      class:list={[
        "relative flex h-10 w-10 items-center justify-center",
        active === "carrito" ? "text-cream" : "text-mist hover:text-cream",
      ]}
    >
      <svg class="h-[22px] w-[22px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 7h15l-1.2 9.2a2 2 0 0 1-2 1.8H8.4a2 2 0 0 1-2-1.7L5 7Zm3-3h8M9 20h.01M17 20h.01"/>
      </svg>
      <span
        data-cart-badge
        class="absolute -right-0.5 -top-0.5 hidden min-w-4 rounded-full bg-amber px-1 text-center font-micro text-[9px] font-semibold text-night"
      >
        0
      </span>
    </a>
  </div>
</header>
