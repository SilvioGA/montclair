---
interface Props {
  para: string;
  base?: string;
  stacked?: boolean;
}

const { para, stacked = false } = Astro.props;
const options = [
  { id: "ambos", label: "Los dos" },
  { id: "el", label: "Él" },
  { id: "ella", label: "Ella" },
];

---

<div
  class:list={[
    stacked ? "flex flex-col gap-1" : "flex h-12 gap-1 rounded-[10px] bg-lift p-1",
  ]}
  data-who-bar
>
  {
    options.map((opt) => {
      const on = para === opt.id || (opt.id === "ambos" && (para === "ambos" || para === "todos" || !para));
      return (
        <button
          type="button"
          data-filter-para={opt.id}
          class:list={[
            stacked
              ? [
                  "flex h-10 items-center rounded-md px-3 text-left font-micro text-[13px] font-semibold tracking-[0.08em]",
                  on ? "bg-amber text-night" : "text-mist hover:text-cream",
                ]
              : [
                  "flex h-full flex-1 items-center justify-center rounded-lg font-poster text-base",
                  on ? "bg-amber text-night" : "text-mist",
                ],
          ]}
        >
          {opt.label}
        </button>
      );
    })
  }
</div>
