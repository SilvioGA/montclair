---
interface Props {
  para: string;
  base?: string;
  stacked?: boolean;
}

const { para, stacked = false } = Astro.props;
const options = [
  { id: "ambos", label: "Los dos" },
  { id: "el", label: "Él" },
  { id: "ella", label: "Ella" },
];
---

<div
  class:list={[
    stacked ? "flex flex-col gap-0.5" : "flex h-12 gap-1 rounded-[10px] bg-lift p-1",
  ]}
  data-who-bar
  {...(stacked ? { "data-who-stacked": true } : {})}
>
  {
    options.map((opt) => {
      const on = para === opt.id || (opt.id === "ambos" && (para === "ambos" || para === "todos" || !para));
      return (
        <button
          type="button"
          data-filter-para={opt.id}
          data-on={on ? "" : undefined}
          class:list={[
            stacked
              ? "flex h-9 items-center rounded-md px-2.5 text-left font-app text-[15px] text-mist transition-[color,background-color] duration-200 ease-[cubic-bezier(0.32,0.72,0,1)] hover:bg-white/[0.08] hover:text-cream data-[on]:bg-white/[0.08] data-[on]:text-cream data-[on]:hover:bg-white/[0.12]"
              : [
                  "flex h-full flex-1 items-center justify-center rounded-lg font-poster text-base",
                  on ? "bg-amber text-night" : "text-mist",
                ],
          ]}
        >
          {opt.label}
        </button>
      );
    })
  }
</div>
