---
import App from "../layouts/App.astro";
import BrandLockup from "../components/BrandLockup.astro";
import PerfumeCard from "../components/PerfumeCard.astro";
import { combos, comboTotal, getPerfume } from "../data/catalog";
import { store } from "../data/config";
import { money } from "../lib/money";

const featured = ["le-beau-le-parfum", "eros-edp", "212-men-edt", "le-male-elixir"]
  .map((slug) => getPerfume(slug))
  .filter((p) => p !== undefined);
const ready = combos.filter((c) => c.slug === "noche" || c.slug === "todo-el-dia");
const wa = `https://wa.me/${store.whatsapp}`;
---

<App title="Inicio" active="inicio">
  <div class="px-5 pt-5 pb-4 md:px-0 md:pt-0 md:pb-0">
    <header class="mb-6 flex items-center justify-between md:hidden">
      <BrandLockup />
      <a href={wa} class="flex items-center gap-1.5 rounded-full bg-amber px-3 py-2 font-micro text-xs font-semibold text-night">
        Chat
      </a>
    </header>

    <section class="md:relative md:flex md:min-h-[78vh] md:items-center">
      <div class="md:relative md:z-10 md:w-[48%] md:pl-[max(2.5rem,calc((100vw-1280px)/2+2.5rem))] md:pr-10">
        <p class="font-micro text-[11px] font-semibold tracking-[0.28em] text-amber">PARFUMS</p>
        <h1 class="mt-2 font-poster text-[42px] leading-[0.95] text-cream md:mt-5 md:text-[84px]">
          Prueba el perfume<br />antes del frasco.
        </h1>
        <p class="mt-3 max-w-[20rem] font-app text-[15px] leading-snug text-mist md:mt-6 md:max-w-md md:text-[18px] md:leading-relaxed">
          El mismo jugo, en 3, 5 o 10 ml. Salimos de {store.city}. Si ya lo conoces, te llevas el grande.
        </p>
        <p class="mt-2 font-app text-[13px] text-mist md:hidden">{store.shippingNote}</p>
        <div class="mt-5 flex flex-col gap-3 md:mt-9 md:flex-row md:items-center md:gap-4">
          <a href="/catalogo" class="flex h-[54px] items-center justify-center rounded-lg bg-amber font-micro text-[15px] font-semibold text-night md:h-14 md:px-10">
            Ver el catálogo
          </a>
          <a href="/combos" class="hidden font-micro text-[13px] font-semibold tracking-[0.08em] text-mist uppercase md:inline">
            O un combo listo
          </a>
        </div>
      </div>
      <div class="hidden md:absolute md:inset-y-0 md:right-0 md:block md:w-[50%]">
        <img src="/products/le-beau.jpg" alt="Le Beau Le Parfum" class="h-full w-full object-cover" />
        <div class="absolute inset-y-0 left-0 w-24 bg-gradient-to-r from-night to-transparent"></div>
      </div>
    </section>

    <div class="hidden border-y border-hair md:block">
      <div class="mx-auto flex max-w-[1280px] items-center justify-between px-10 py-5">
        <p class="font-micro text-[12px] font-semibold tracking-[0.16em] text-mist">3 · 5 · 10 ML</p>
        <p class="font-micro text-[12px] font-semibold tracking-[0.16em] text-mist">ORIGINALES</p>
        <p class="font-micro text-[12px] font-semibold tracking-[0.16em] text-mist">PEDÍS POR WHATSAPP</p>
        <p class="font-micro text-[12px] font-semibold tracking-[0.16em] text-mist">SALIMOS DE ESTELÍ</p>
      </div>
    </div>

    <div class="md:mx-auto md:max-w-[1280px] md:px-10 md:pb-24">
      <div class="mt-8 flex items-end justify-between md:mt-24">
        <div>
          <p class="font-micro text-[11px] font-semibold tracking-[0.12em] text-amber">LOS MÁS PEDIDOS</p>
          <h2 class="font-poster text-[22px] text-cream md:mt-2 md:text-[40px]">Empieza por uno</h2>
        </div>
        <a href="/catalogo" class="font-micro text-xs font-semibold text-mist">Ver todos</a>
      </div>
      <div data-stagger class="mt-3 grid grid-cols-2 gap-3 md:mt-10 md:grid-cols-4 md:gap-8">
        {featured.map((perfume) => <PerfumeCard perfume={perfume} />)}
      </div>

      <div class="mt-8 flex items-end justify-between md:mt-28">
        <div>
          <p class="font-micro text-[11px] font-semibold tracking-[0.12em] text-mist">SI NO QUIERES ELEGIR</p>
          <h2 class="font-poster text-[20px] text-cream md:mt-2 md:text-[40px]">Combos listos</h2>
        </div>
        <a href="/combos" class="font-micro text-xs font-semibold text-mist">Ver combos</a>
      </div>
      <div data-stagger class="mt-3 grid grid-cols-2 gap-3 md:mt-10 md:gap-8">
        {
          ready.map((combo) => (
            <a href={`/combos/${combo.slug}`} class="group relative flex flex-col gap-1.5">
              <div class="overflow-hidden rounded-lg bg-lift md:rounded-2xl">
                <img src={combo.image} alt={combo.name} class="h-[110px] w-full object-cover md:h-[380px] md:transition-transform md:duration-700 md:ease-[cubic-bezier(0.32,0.72,0,1)] md:group-hover:scale-[1.03]" />
              </div>
              <p class="font-poster text-lg uppercase text-cream md:mt-3 md:text-3xl">{combo.name}</p>
              <p class="font-app text-xs text-amber md:text-sm">{money(comboTotal(combo))}</p>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</App>
