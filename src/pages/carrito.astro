---
import App from "../layouts/App.astro";
import { store } from "../data/config";
---

<App title="Carrito" active="carrito">
  <div class="px-5 pt-5 pb-6 md:mx-auto md:max-w-[1280px] md:px-10 md:pt-12 md:pb-24" data-cart-page data-cart-step="summary">
    <header data-cart-heading class="flex items-end justify-between">
      <div>
        <p class="hidden font-micro text-[11px] font-semibold tracking-[0.2em] text-amber md:block">TU PEDIDO</p>
        <h1 class="font-poster text-[32px] tracking-[-0.04em] text-cream md:mt-2 md:text-[56px]">
          <span class="md:hidden">CARRITO</span>
          <span class="hidden md:inline">Carrito</span>
        </h1>
      </div>
      <p data-cart-count class="font-app text-sm text-mist md:mb-2.5">0 productos</p>
    </header>

    <div data-cart-empty class="mt-10 md:mt-16 md:max-w-xl">
      <p class="font-poster text-2xl text-cream md:text-[40px] md:leading-none">Todavía no hay nada</p>
      <p class="mt-2 max-w-md font-app text-sm text-mist md:mt-4 md:text-[17px] md:leading-relaxed">
        Suma un perfume del catálogo. Eliges los ml y ves el precio en córdobas antes de pedir.
      </p>
      <div class="mt-5 flex flex-col gap-2 md:mt-8 md:flex-row md:gap-3">
        <a href="/catalogo" class="flex h-12 items-center justify-center rounded-lg bg-amber font-micro text-sm font-semibold text-night md:h-14 md:px-8">Ir al catálogo</a>
        <a href="/combos" class="flex h-12 items-center justify-center rounded-lg border border-hair font-micro text-sm text-cream md:h-14 md:px-8">Ver combos</a>
      </div>
    </div>

    <div data-cart-filled class="hidden">
      <div data-step-summary>
        <div class="md:mt-10 md:grid md:grid-cols-[1fr_340px] md:items-start md:gap-14">
          <div data-cart-list class="mt-5 flex flex-col gap-2.5 md:mt-0"></div>

          <div class="md:sticky md:top-28">
            <div class="mt-5 rounded-xl bg-lift px-4 py-4 md:mt-0 md:px-6 md:py-6">
              <div class="flex items-end justify-between">
                <p class="font-micro text-xs font-semibold tracking-[0.12em] text-amber">TOTAL</p>
                <p data-cart-total class="font-poster text-[34px] leading-none text-cream">C$ 0</p>
              </div>
              <p class="mt-2 font-app text-xs text-mist">Córdobas. {store.shippingNote} {store.coverage}</p>
            </div>

            <div data-cart-nudge class="mt-3 hidden rounded-xl border border-hair px-4 py-3">
              <p class="font-app text-sm text-cream">Si sumas otro, pruebas más por casi lo mismo.</p>
              <a href="/catalogo" class="mt-1 inline-block font-micro text-xs font-semibold text-amber">Seguir en el catálogo</a>
            </div>

            <div class="mt-5 flex flex-col gap-2">
              <button
                type="button"
                data-go-checkout
                class="flex h-[54px] w-full items-center justify-center rounded-lg bg-amber font-micro text-[15px] font-semibold text-night"
              >
                Continuar el pedido
              </button>
              <a href="/catalogo" class="flex h-12 items-center justify-center font-micro text-sm text-mist">Seguir mirando</a>
            </div>
          </div>
        </div>
      </div>

      <div data-step-checkout class="hidden">
        <button
          type="button"
          data-back-summary
          class="mt-1 inline-flex items-center gap-2 font-micro text-[12px] font-semibold tracking-[0.16em] uppercase text-mist hover:text-cream md:mt-0"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6 9 12l6 6"/></svg>
          Carrito
        </button>

        <div class="mt-5 md:mt-8 md:grid md:grid-cols-[minmax(0,1fr)_340px] md:items-start md:gap-14">
          <div class="rounded-xl bg-lift px-4 py-3 md:sticky md:top-28 md:order-2 md:mt-0 md:px-6 md:py-6">
            <p class="font-micro text-[10px] font-semibold tracking-[0.12em] text-amber">VAS A PEDIR</p>
            <p data-cart-recap class="mt-1 font-app text-sm text-cream"></p>
            <p data-cart-total class="mt-3 font-poster text-2xl text-cream md:text-[34px] md:leading-none">C$ 0</p>
          </div>

          <form data-checkout-form class="mt-5 flex flex-col gap-4 md:order-1 md:mt-0">
          <label class="block">
            <span class="font-app text-[13px] text-mist">¿A nombre de quién?</span>
            <input name="name" required class="mt-1.5 w-full rounded-lg bg-lift px-3 py-3.5 font-app text-[15px] outline-none ring-0 focus:outline-amber" placeholder="María González" />
          </label>
          <label class="block">
            <span class="font-app text-[13px] text-mist">¿Tu WhatsApp?</span>
            <input name="phone" required inputmode="tel" class="mt-1.5 w-full rounded-lg bg-lift px-3 py-3.5 font-app text-[15px] outline-none" placeholder="8888 0000" />
          </label>
          <label class="block">
            <span class="font-app text-[13px] text-mist">¿En qué ciudad?</span>
            <select name="city" required class="mt-1.5 w-full appearance-none rounded-lg bg-lift px-3 py-3.5 font-app text-[15px] outline-none">
              {store.cities.map((city) => (
                <option value={city} selected={city === store.city}>{city}</option>
              ))}
            </select>
          </label>
          <label class="block">
            <span class="font-app text-[13px] text-mist">Barrio y dirección</span>
            <input name="address" required class="mt-1.5 w-full rounded-lg bg-lift px-3 py-3.5 font-app text-[15px] outline-none" placeholder="Barrio, casa, punto de referencia" />
          </label>

          <fieldset>
            <legend class="font-app text-[13px] text-mist">¿Cómo quieres pagar?</legend>
            <div class="mt-2 flex flex-col gap-2">
              <label class="flex items-center gap-3 rounded-xl bg-lift px-3.5 py-3">
                <input type="radio" name="pay" value="Transferencia" checked class="accent-amber" />
                <span>
                  <span class="block font-app text-sm text-cream">Transferencia</span>
                  <span class="block font-app text-xs text-mist">Te pasamos los datos por chat</span>
                </span>
              </label>
              <label class="flex items-center gap-3 rounded-xl bg-lift px-3.5 py-3">
                <input type="radio" name="pay" value="Pago móvil" class="accent-amber" />
                <span>
                  <span class="block font-app text-sm text-cream">Pago móvil</span>
                  <span class="block font-app text-xs text-mist">Igual, te lo confirmamos al pedir</span>
                </span>
              </label>
              <label class="flex items-center gap-3 rounded-xl bg-lift px-3.5 py-3">
                <input type="radio" name="pay" value="Al llegar" class="accent-amber" />
                <span>
                  <span class="block font-app text-sm text-cream">Cuando me llegue</span>
                  <span class="block font-app text-xs text-mist">Si estamos en tu zona</span>
                </span>
              </label>
            </div>
          </fieldset>

          <button
            type="submit"
            data-cart-cta
            class="flex h-[54px] w-full items-center justify-center rounded-lg bg-amber font-micro text-[15px] font-semibold text-night"
          >
            Pedir por WhatsApp
          </button>
          <p class="text-center font-app text-xs text-mist md:text-left">Se abre WhatsApp con el pedido escrito. Sin crear cuenta.</p>
          </form>
        </div>
      </div>
    </div>
  </div>
</App>
