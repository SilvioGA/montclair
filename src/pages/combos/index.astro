---
import App from "../../layouts/App.astro";
import BrandLockup from "../../components/BrandLockup.astro";
import ComboCard from "../../components/ComboCard.astro";
import WhoBar from "../../components/WhoBar.astro";
import { combos } from "../../data/catalog";
import { store } from "../../data/config";

const q = Astro.url.searchParams.get("q")?.trim().toLowerCase() ?? "";
const list = q
  ? combos.filter((c) => `${c.name} ${c.blurb}`.toLowerCase().includes(q))
  : combos;
const wa = `https://wa.me/${store.whatsapp}`;
---

<App title="Combos" active="combos">
  <div class="px-5 pt-5 pb-4">
    <header class="mb-4 flex items-center justify-between">
      <BrandLockup compact />
      <a href={wa} class="flex items-center gap-1.5 rounded-full bg-amber px-3 py-2 font-micro text-xs font-semibold text-night">
        Chat
      </a>
    </header>

    <h1 class="font-poster text-5xl text-cream">COMBOS</h1>
    <p class="mt-3 font-app text-[15px] leading-snug text-mist">
      Packs de 3 × 5 ml que ya oliemos. El precio es la suma. Enviamos desde {store.city}. {store.shippingNote}
    </p>

    <div class="mt-4">
      <WhoBar para="ambos" />
    </div>
    <div class="mt-3 flex gap-2 overflow-x-auto pb-1 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" data-combo-moods>
      {
        [
          ["todos", "Todos"],
          ["noche", "Noche"],
          ["oficina", "Oficina"],
          ["dulce", "Dulce"],
          ["fresco", "Fresco"],
        ].map(([id, label]) => (
          <button
            type="button"
            data-filter-combo-mood={id}
            class:list={[
              "shrink-0 rounded-full px-3 py-1.5 font-micro text-xs font-semibold",
              id === "todos" ? "bg-amber text-night" : "bg-lift text-mist",
            ]}
          >
            {label}
          </button>
        ))
      }
    </div>

    <label class="mt-4 flex items-center gap-2 rounded-lg bg-lift px-3.5 py-3">
      <svg class="h-4 w-4 text-mist" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input
        data-search="/combos"
        type="search"
        value={q}
        placeholder="Busca un combo…"
        class="w-full bg-transparent font-app text-sm outline-none"
      />
    </label>

    <p class="mt-5 font-micro text-[11px] font-semibold tracking-[0.12em] text-amber">
      <span data-combo-count>{list.length}</span> COMBOS
    </p>
    <div data-stagger class="mt-3 grid grid-cols-2 gap-3">
      {list.map((combo) => <ComboCard combo={combo} />)}
    </div>
  </div>
</App>
