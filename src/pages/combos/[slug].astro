---
import App from "../../layouts/App.astro";
import BackLink from "../../components/BackLink.astro";
import { combos, comboLines, comboTotal, getCombo } from "../../data/catalog";
import { comboPayload } from "../../lib/payload";
import { money } from "../../lib/money";
import { store } from "../../data/config";

export function getStaticPaths() {
  return combos.map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const combo = getCombo(slug!);
if (!combo) return Astro.redirect("/combos");

const lines = comboLines(combo);
const total = comboTotal(combo);
const payload = JSON.stringify(comboPayload(combo));
const parts = lines.map((l) => l.size.price).join(" + ");
---

<App title={combo.name} active="combos">
  <div class="md:mx-auto md:max-w-[1280px] md:px-10 md:pt-8 md:pb-24">
    <div class="flex h-[52px] items-center justify-between px-5 md:h-auto md:justify-start md:px-0 md:pb-5">
      <BackLink href="/combos" label="Combos" />
      <p class="font-poster text-lg tracking-wide text-cream md:hidden">COMBO</p>
      <span class="w-6 md:hidden" aria-hidden="true"></span>
    </div>

    <div class="md:grid md:grid-cols-2 md:items-start md:gap-16">
    <div class="relative h-60 overflow-hidden bg-lift md:h-[560px] md:rounded-2xl">
      <img src={combo.image} alt={combo.name} class="h-full w-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-t from-night via-night/40 to-transparent md:hidden"></div>
      <h1 class="absolute bottom-4 left-5 font-poster text-6xl uppercase text-cream md:hidden">{combo.name}</h1>
    </div>

    <div class="px-5 pt-4 pb-6 md:sticky md:top-28 md:px-0 md:pt-4">
      <p class="hidden font-micro text-[11px] font-semibold tracking-[0.2em] text-amber md:block">COMBO · 3 × 5 ML</p>
      <h1 class="hidden font-poster text-[64px] uppercase leading-none text-cream md:mt-3 md:block">{combo.name}</h1>
      <p class="font-app text-[15px] text-mist">{combo.blurb}</p>

      <ul class="mt-4 divide-y divide-hair">
        {
          lines.map(({ perfume, size }) => (
            <li class="flex items-center justify-between py-3">
              <div>
                <p class="font-poster text-xl text-cream">{perfume.name}</p>
                <p class="font-app text-[13px] text-mist">
                  {perfume.smell.split(".")[0]} · {size.label}
                </p>
              </div>
              <p class="font-poster text-xl text-cream">{money(size.price)}</p>
            </li>
          ))
        }
      </ul>

      <div class="mt-2 flex items-end justify-between">
        <p class="font-micro text-[13px] font-semibold text-amber">TOTAL</p>
        <p class="font-poster text-[32px] leading-none text-amber">{money(total)}</p>
      </div>
      <p class="mt-2 font-app text-[13px] text-mist">
        {parts}. Cada uno a su precio. {store.shippingNote} Si quieres otro tamaño, súmalo desde el catálogo.
      </p>

      <button
        type="button"
        data-add-combo={payload}
        class="mt-4 flex h-[54px] w-full items-center justify-center rounded-lg bg-amber font-micro text-[15px] font-semibold text-night"
      >
        Sumar los 3 al carrito
      </button>
      <p class="mt-3 text-center font-app text-[13px] text-mist">
        ¿Quieres cambiar uno? Entra al <a href="/catalogo" class="text-cream underline">catálogo</a> y arma el tuyo.
      </p>
    </div>
    </div>
  </div>
</App>
