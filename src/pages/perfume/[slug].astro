---
import App from "../../layouts/App.astro";
import { combos, comboLines, comboTotal, getPerfume, genderLabel, perfumes, worldLabel, type Perfume } from "../../data/catalog";
import { comboPayload, perfumePayload } from "../../lib/payload";
import { money } from "../../lib/money";
import { store } from "../../data/config";

function whyPair(base: Perfume, other: Perfume) {
  if (other.moods.includes("dulce") && base.moods.includes("dulce")) return "Otro dulce, para no oler siempre lo mismo.";
  if (other.moods.includes("fresco") && base.moods.includes("fresco")) return "Más fresco. Para el día, si este te queda pesado.";
  if (other.moods.includes("noche") && !base.moods.includes("noche")) return "La versión noche. Más presencia.";
  if (other.world === "arabes" && base.world !== "arabes") return "Árabe: rinde, se queda, cuesta menos olerlo.";
  if (other.world === "nicho") return "Nicho. Si este te enamoró, este otro también pega.";
  return other.smell.split(".")[0] + ".";
}

export function getStaticPaths() {
  return perfumes.map((p) => ({ params: { slug: p.slug } }));
}

const perfume = getPerfume(Astro.params.slug!);
if (!perfume) return Astro.redirect("/catalogo");

const payload = perfumePayload(perfume);
const decants = perfume.sizes.filter((s) => s.key !== "frasco");
const bottle = perfume.sizes.find((s) => s.key === "frasco");
const related = perfume.related.map((s) => getPerfume(s)).filter((p): p is Perfume => Boolean(p));
const suggestedCombo = combos.find((c) => c.items.some((i) => i.slug === perfume.slug));
const comboItems = suggestedCombo ? comboLines(suggestedCombo) : [];
const comboSum = suggestedCombo ? comboTotal(suggestedCombo) : 0;
const tags = [genderLabel[perfume.gender], worldLabel[perfume.world], perfume.moods[0]];
---

<App title={perfume.name} active="catalogo">
  <div
    data-perfume-page={JSON.stringify(payload)}
    data-selected-size="3"
  >
    <div class="flex h-[52px] items-center justify-between px-5">
      <a href="/catalogo" data-back class="text-cream" aria-label="Volver">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M15 6 9 12l6 6"/></svg>
      </a>
      <p class="font-poster text-lg uppercase tracking-wide text-cream">{perfume.name}</p>
      <span class="w-6" aria-hidden="true"></span>
    </div>

    <div class="relative aspect-square overflow-hidden bg-lift">
      <img src={perfume.image} alt={`${perfume.house} ${perfume.name}`} class="h-full w-full object-cover" />
      {
        !perfume.available && (
          <span class="absolute left-4 top-4 rounded-full bg-[#c43b3b] px-3 py-1 font-micro text-[11px] font-semibold text-cream">
            Agotado
          </span>
        )
      }
    </div>

    <div class="px-5 pt-5">
      <div class="flex flex-wrap gap-1.5">
        {
          tags.map((t) => (
            <span class="rounded-full bg-lift px-2.5 py-1 font-micro text-[11px] capitalize text-mist">{t}</span>
          ))
        }
      </div>
      <p class="mt-3 font-micro text-[11px] font-semibold tracking-[0.14em] text-amber">{perfume.house.toUpperCase()}</p>
      <h1 class="font-poster text-4xl text-cream">{perfume.name}</h1>
      <p class="mt-2 font-app text-[15px] text-mist">{perfume.smell}</p>

      {
        perfume.available ? (
          <>
            <p class="mt-5 font-app text-sm font-semibold text-cream">¿De cuánto?</p>
            <div class="mt-2 flex gap-2">
              {decants.map((s, i) => (
                <button
                  type="button"
                  data-select-size={s.key}
                  class:list={[
                    "flex flex-1 flex-col items-center rounded-lg px-2 py-3",
                    i === 0 ? "bg-amber text-night" : "bg-lift text-cream",
                  ]}
                >
                  <span class="font-micro text-xs font-semibold">{s.label}</span>
                  <span class="font-poster text-base">{money(s.price)}</span>
                </button>
              ))}
            </div>
            {bottle && (
              <button
                type="button"
                data-select-size={bottle.key}
                class="mt-2 flex w-full items-center justify-between rounded-lg bg-lift px-3.5 py-3.5 text-left text-cream"
              >
                <span>
                  <span class="block font-app text-sm font-semibold">Frasco completo</span>
                  <span class="block font-app text-xs text-mist">Si ya lo conoces</span>
                </span>
                <span class="font-poster text-xl">{money(bottle.price)}</span>
              </button>
            )}
            <button
              type="button"
              data-perfume-cta
              class="mt-4 flex h-[54px] w-full items-center justify-center rounded-lg bg-amber font-micro text-[15px] font-semibold text-night"
            >
              Sumar 3 ml · {money(decants[0].price)}
            </button>
            <p class="mt-2 text-center font-app text-[12px] text-mist">{store.shippingNote}</p>
          </>
        ) : (
          <div class="mt-6 rounded-lg bg-lift px-4 py-4">
            <p class="font-app text-sm text-mist">Hoy no hay. Escríbenos y te avisamos cuando vuelva.</p>
            <a
              href={`https://wa.me/${store.whatsapp}?text=${encodeURIComponent(`Hola, ¿cuándo vuelve ${perfume.name}?`)}`}
              class="mt-3 flex h-11 items-center justify-center rounded-lg bg-amber font-micro text-sm font-semibold text-night"
            >
              Preguntar por WhatsApp
            </a>
          </div>
        )
      }
    </div>

    <div class="px-5 pt-8 pb-8">
      {
        related.length > 0 && (
          <section>
            <p class="font-micro text-[11px] font-semibold tracking-[0.18em] text-amber">SI TE GUSTA ESTE</p>
            <h2 class="mt-1 font-poster text-[24px] leading-none text-cream">Estos seguro también.</h2>
            <p class="mt-2 font-app text-sm text-mist">Misma familia de olor. Para no llevarte uno solo y arrepentirte.</p>
            <ul class="mt-4 flex flex-col gap-3">
              {related.map((r) => {
                const start = r.sizes.find((s) => s.key === "5") ?? r.sizes[0];
                return (
                  <li>
                    <a href={`/perfume/${r.slug}`} class="flex items-center gap-3 rounded-xl bg-lift p-3">
                      <img src={r.image} alt={r.name} class="h-16 w-12 shrink-0 rounded-md object-cover bg-night" />
                      <div class="min-w-0 flex-1">
                        <p class="font-poster text-lg leading-none text-cream">{r.name}</p>
                        <p class="mt-1.5 font-app text-[13px] leading-snug text-mist">{whyPair(perfume, r)}</p>
                      </div>
                      <p class="shrink-0 text-right font-poster text-sm text-amber">
                        {start.label}
                        <span class="mt-0.5 block">{money(start.price)}</span>
                      </p>
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        )
      }

      {
        suggestedCombo && (
          <section class="mt-8 rounded-2xl bg-lift p-4">
            <p class="font-micro text-[11px] font-semibold tracking-[0.22em] text-amber">O EL PACK COMPLETO</p>
            <h2 class="mt-2 font-poster text-[24px] leading-none text-cream">Los tres de una vez.</h2>
            <p class="mt-2 font-app text-sm leading-snug text-mist">
              Combo {suggestedCombo.name}: 5 ml de cada uno. Ya los oliemos juntos.
            </p>
            <ul class="mt-4 flex flex-col gap-2.5">
              {comboItems.map(({ perfume: item, size }) => (
                <li class="flex items-center gap-3">
                  <img src={item.image} alt="" class="h-12 w-10 rounded-md object-cover bg-night" />
                  <div class="min-w-0 flex-1">
                    <p class="font-poster text-base leading-none text-cream">
                      {item.name}
                      {item.slug === perfume.slug && <span class="ml-1 font-app text-[11px] text-amber">este</span>}
                    </p>
                    <p class="mt-1 font-app text-xs text-mist">{size.label}</p>
                  </div>
                  <p class="font-poster text-sm text-cream">{money(size.price)}</p>
                </li>
              ))}
            </ul>
            <div class="mt-4 flex items-end justify-between">
              <p class="font-app text-xs text-mist">Los tres, listos</p>
              <p class="font-poster text-2xl text-amber">{money(comboSum)}</p>
            </div>
            <button
              type="button"
              data-add-combo={JSON.stringify(comboPayload(suggestedCombo))}
              class="mt-3 flex h-12 w-full items-center justify-center rounded-lg bg-amber font-micro text-sm font-semibold text-night"
            >
              Sumar el pack {suggestedCombo.name}
            </button>
            <a href={`/combos/${suggestedCombo.slug}`} class="mt-2 flex h-10 items-center justify-center font-micro text-xs text-mist">
              Ver el pack
            </a>
          </section>
        )
      }
    </div>
  </div>
</App>
